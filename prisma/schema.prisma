// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

//   GENERATOR & DATASOURCE  (Prisma 7 Syntax)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
//  url      = env("DATABASE_URL")
}

model BoardGame {
  id            Int     @id
  name          String
  yearPublished Int?
  rank          Int?
  bayesAverage  Float?
  averageRating Float?
  usersRated    Int?
  isExpansion   Boolean

  strategyRank  Int?
  partyRank     Int?
  familyRank    Int?
}

