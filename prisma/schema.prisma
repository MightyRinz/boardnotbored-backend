// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

//   GENERATOR & DATASOURCE  (Prisma 7 Syntax)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BoardGame {
  id            Int     @id
  name          String
  yearPublished Int?
  rank          Int?
  bayesAverage  Float?
  averageRating Float?
  usersRated    Int?
  isExpansion   Boolean

  strategyRank Int?
  partyRank    Int?
  familyRank   Int?

  interactions UserGameInteraction[]
  shopGames    ShopGame[]
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())

  interactions        UserGameInteraction[]
  bookings            Booking[]
  bookingParticipants BookingParticipant[]
}

model UserGameInteraction {
  id     Int @id @default(autoincrement())
  userId Int
  gameId Int

  rating Int? // 1-5
  played Boolean @default(true)

  user User      @relation(fields: [userId], references: [id])
  game BoardGame @relation(fields: [gameId], references: [id])

  @@unique([userId, gameId])
}

model Shop {
  id          Int      @id @default(autoincrement())
  name        String
  address     String?
  createdAt   DateTime @default(now())
  openingTime String?
  closingTime String?

  games  ShopGame[]
  tables Table[]
}

model ShopGame {
  id     Int @id @default(autoincrement())
  shopId Int
  gameId Int

  shop Shop      @relation(fields: [shopId], references: [id])
  game BoardGame @relation(fields: [gameId], references: [id])

  @@unique([shopId, gameId])
}

model Table {
  id       Int @id @default(autoincrement())
  shopId   Int
  number   Int
  capacity Int

  shop     Shop      @relation(fields: [shopId], references: [id])
  bookings Booking[]

  @@unique([shopId, number])
}

model Booking {
  id        Int      @id @default(autoincrement())
  userId    Int
  tableId   Int
  startTime DateTime
  endTime   DateTime
  status    String   @default("confirmed")
  createdAt DateTime @default(now())

  isOpenParty Boolean @default(false) // if true, anyone can join until maxPlayers is reached
  maxPlayers  Int?

  user                User                 @relation(fields: [userId], references: [id])
  table               Table                @relation(fields: [tableId], references: [id])
  bookingParticipants BookingParticipant[]
}

model BookingParticipant {
  id        Int @id @default(autoincrement())
  bookingId Int
  userId    Int

  booking Booking @relation(fields: [bookingId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([bookingId, userId])
}
